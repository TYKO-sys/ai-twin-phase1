# ============================================================
# AI Twin — secrets file
# ============================================================
# Copy this file to .env (same folder) and fill in your values.
# At least ONE AI API key is required. More keys = more resilience.
# ============================================================

# Your Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Your own Telegram user ID (numeric).
# Get it by messaging @userinfobot on Telegram.
ALLOWED_USER_ID=

# ---- LLM Providers (set at least one) ----

# OpenRouter — 300+ models, one key. RECOMMENDED.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# DeepSeek — cheap, high quality, generous free tier.
# https://chat.deepseek.com/ → sign up → settings → API keys
DEEPSEEK_API_KEY=

# Gemini — Google's free AI. 250 req/day free.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Z.ai — GLM models, free tier.
# https://chat.z.ai/ → sign up → settings → API key
ZAI_API_KEY=

# Optional: specify which provider to use first
# Options: openrouter, deepseek, gemini, zai
# Default: tries openrouter → deepseek → zai → gemini
# PREFERRED_PROVIDER=openrouter

# Where memory files live. Default is fine.
# MEMORY_DIR=/data/data/com.termux/files/home/ai-twin-memory
