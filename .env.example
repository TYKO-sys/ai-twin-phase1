# ============================================================
# AI Twin — secrets file
# ============================================================
# At least ONE AI API key is required. More keys = more resilience.
# All of these are FREE — no credit card needed.
# ============================================================

# Your Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Your own Telegram user ID (numeric).
# Get it by messaging @userinfobot on Telegram.
ALLOWED_USER_ID=

# ---- LLM Providers (set at least one) ----
# All FREE. Add as many as you can for maximum reliability.
# The bot rotates through all available providers automatically.

# FreeLLMAPI — 34 free providers, 7.4B tokens/month, NO key needed
# Just leave this uncommented — it's always available
FREELLMAPI_API_KEY=free

# Groq — FREE, very fast (14,400 req/day). RECOMMENDED.
# https://console.groq.com/ → create API key
GROQ_API_KEY=

# OpenRouter — FREE, 20+ free models.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Mistral — FREE, 1 billion tokens/month.
# https://console.mistral.ai/ → API keys
MISTRAL_API_KEY=

# Cerebras — FREE, 1 million tokens/day, very fast.
# https://inference.cerebras.ai/
CEREBRAS_API_KEY=

# Z.ai — FREE, GLM models.
# https://chat.z.ai/ → settings → API key
ZAI_API_KEY=

# Gemini — FREE, 1,500 requests/day.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Where memory files live. Default is fine.
# MEMORY_DIR=/data/data/com.termux/files/home/ai-twin-memory
