# ============================================================
# AI Twin — secrets file
# ============================================================
# Copy this file to .env (same folder) and fill in your values.
# Command:
#   cp .env.example .env
# Then edit .env with any text editor (or nano in Termux).
#
# Get your values from MANUAL_STEPS.md if you don't have them yet.
# ============================================================

# Your Telegram bot token from @BotFather.
# Looks like: 7123456789:AAH-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_BOT_TOKEN=

# Your Gemini API key from https://aistudio.google.com/apikey
# Looks like: AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=

# Your own Telegram user ID (numeric).
# Get it by messaging @userinfobot on Telegram — it replies with your ID.
# This ensures ONLY YOU can talk to your twin.
ALLOWED_USER_ID=

# Where memory files live. Default is fine — leave as is.
# MEMORY_DIR=/data/data/com.termux/files/home/ai-twin-memory
